POSTGRES_DB=studylens
POSTGRES_USER=studylens
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Use fake for deterministic release verification, or gemini for the three
# real-provider acceptance cases. The key remains only in deploy/release.env.
LLM_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TRANSCRIPT_TIMEOUT_SECONDS=300
QUIZ_TIMEOUT_SECONDS=180
GRADING_TIMEOUT_SECONDS=60
