POSTGRES_DB=studylens
POSTGRES_USER=studylens
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_PORT=5432

# Normal release runs use Gemini. Keep the real key in the ignored root .env
# (preferred) or the ignored deploy/release.env file. Never commit the key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TRANSCRIPT_TIMEOUT_SECONDS=300
QUIZ_TIMEOUT_SECONDS=180
GRADING_TIMEOUT_SECONDS=60
