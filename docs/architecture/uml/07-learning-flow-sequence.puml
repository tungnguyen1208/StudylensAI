@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceArrowThickness 1
skinparam sequenceArrowColor #3F6B47
skinparam participantBorderColor #3F6B47
skinparam participantBackgroundColor #F2F8EE

actor Learner
participant "YouTube" as YouTube
participant "Extension" as Extension
participant "Backend" as Backend
database "PostgreSQL" as DB
participant "FastAPI" as AI
participant "Gemini" as Gemini

Learner -> Extension : Turn ON and open video
Extension -> Backend : POST /api/sessions
Backend -> DB : Create or replay session
Extension -> YouTube : Load captionTracks and Timedtext
alt Full captions are verifiable
  Extension -> Backend : PUT full transcript once
else Captions unavailable or insufficient
  Extension -> Backend : PUT unavailable or insufficient
  Backend -> AI : Generate transcript from public video URL
  AI -> Gemini : Analyze video audio
  Gemini --> AI : Timestamped transcript
  AI --> Backend : Validated transcript
end
Backend -> DB : Persist transcript and quiz job
Backend -> AI : Generate quiz with video title and cues
AI -> Gemini : Grounded prompt
Gemini --> AI : Cue-indexed questions
AI --> Backend : Validated quiz payload
Backend -> DB : Publish one ready quiz atomically
Extension -> Backend : Poll learning package
Backend --> Extension : Transcript and ready quiz
Learner -> Extension : Submit entire quiz
Extension -> Backend : POST quiz attempt
Backend -> DB : Save attempt and answers atomically
Backend --> Extension : Score, explanation and evidence
Learner -> Extension : Open history or seek evidence
@enduml
