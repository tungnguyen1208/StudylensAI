@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle
skinparam componentBackgroundColor #F2F8EE
skinparam componentBorderColor #3F6B47
skinparam ArrowColor #3F6B47

component "Side Panel UI" as UI
component "Service Worker" as SW
component "Content Script" as CS
component "Video Context Reader" as VCR
component "Transcript Adapter\ncaptionTracks > JSON3 > XML > DOM" as TA
component "Player Controller" as PC
database "chrome.storage.local\nActivation and preferences" as Storage
cloud "YouTube Page and Player" as YouTube
component "ASP.NET Core Backend" as Backend

UI <--> SW : Commands and state
SW <--> CS : Typed messages
SW <--> Storage : Persist ON/OFF
CS --> VCR
CS --> TA
CS --> PC
VCR --> YouTube : Video ID, title, duration
TA --> YouTube : Full captions
PC --> YouTube : Seek only on user action
SW --> Backend : REST / JSON
@enduml
