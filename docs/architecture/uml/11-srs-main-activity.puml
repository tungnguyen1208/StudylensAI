@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activityBackgroundColor #F2F8EE
skinparam activityBorderColor #3F6B47
skinparam ArrowColor #3F6B47

start
:Restore persistent ON/OFF state;
if (StudyLens ON and valid /watch video?) then (yes)
  :Create or replay study session;
  :Read captionTracks and Timedtext;
  if (Full transcript verifiable?) then (yes)
    :Upload one canonical transcript;
  else (no)
    :Submit unavailable or insufficient status;
    :Backend requests Gemini video transcript fallback;
  endif
  :Persist transcript and durable quiz job;
  :Generate grounded full-video quiz;
  if (Quiz payload valid?) then (yes)
    :Publish ready learning package;
    :Learner submits entire quiz;
    :Grade and save attempt atomically;
    :Show result, evidence and video-linked history;
  else (no)
    :Keep retryable error state;
    :Do not save partial quiz or completed history;
  endif
else (no)
  :Do not create session or call AI;
endif
stop
@enduml
