@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam stateBackgroundColor #F2F8EE
skinparam stateBorderColor #3F6B47
skinparam ArrowColor #3F6B47

[*] --> Off
Off --> Acquiring : User turns StudyLens ON\non a valid video
Acquiring --> Processing : Full transcript accepted\nor fallback job created
Processing --> Ready : Quiz job succeeds
Processing --> Error : Provider, validation or network failure
Error --> Processing : Manual Retry\nsame session and idempotency key
Ready --> Submitted : Submit entire quiz
Submitted --> History : Result persisted by video and session
History --> Ready : Review quiz
History --> Acquiring : Open another video
Acquiring --> Off : User turns OFF or leaves /watch
Processing --> Off : User turns OFF or leaves /watch

state "Side Panel Tabs" as Tabs {
  state Study
  state History
  state Settings
}
@enduml
