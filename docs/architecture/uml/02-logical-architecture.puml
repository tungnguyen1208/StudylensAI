@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam ArrowColor #3F6B47
skinparam PackageBorderColor #7EAA68
skinparam ComponentBorderColor #3F6B47
skinparam ComponentBackgroundColor #F2F8EE

package "Presentation Layer" {
  [Side Panel UI] as UI
  [YouTube Context Adapter] as Context
}
package "Extension Application Layer" {
  [Persistent Activation] as Activation
  [Active Tab and Video Isolation] as Isolation
  [Learning Package Polling] as Polling
}
package "Backend Application Layer" {
  [Session and Transcript Workflow] as Session
  [Durable Processing Jobs] as Jobs
  [Assessment and History] as Assessment
}
package "Integration Layer" {
  [ASP.NET Core REST API] as API
  [FastAPI AI Boundary] as FastAPI
}
package "Data and External Services" {
  database "PostgreSQL" as DB
  cloud "YouTube Timedtext" as Timedtext
  cloud "Google Gemini API" as Gemini
}

UI --> Activation
Context --> Isolation
Context --> Timedtext
Activation --> API
Isolation --> API
Polling --> API
API --> Session
Session --> Jobs
Session --> Assessment
Jobs --> FastAPI
Assessment --> FastAPI
Session --> DB
Jobs --> DB
Assessment --> DB
FastAPI --> Gemini
@enduml
