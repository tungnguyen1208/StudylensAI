@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecaseBackgroundColor #F2F8EE
skinparam usecaseBorderColor #3F6B47
skinparam ArrowColor #3F6B47

actor Learner
actor "YouTube Web" as YouTube
actor "Google Gemini API" as Gemini

rectangle "StudyLens AI" {
  usecase "Turn StudyLens ON or OFF" as UC1
  usecase "Open or switch video" as UC2
  usecase "Acquire full transcript" as UC3
  usecase "Generate full-video quiz" as UC4
  usecase "Submit entire quiz" as UC5
  usecase "Review result and evidence" as UC6
  usecase "Review video-linked history" as UC7
  usecase "Retry failed processing step" as UC8
}

Learner --> UC1
Learner --> UC2
Learner --> UC5
Learner --> UC6
Learner --> UC7
Learner --> UC8
YouTube --> UC3
Gemini --> UC3 : Fallback only
Gemini --> UC4
Gemini --> UC5 : Short answer only
UC2 ..> UC3 : <<include>>
UC3 ..> UC4 : <<include>>
@enduml
