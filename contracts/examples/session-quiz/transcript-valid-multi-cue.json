  "cues": [
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000001", "startMs": 0, "endMs": 30000, "text": "Hôm nay chúng ta tìm hiểu cách dữ liệu đi qua mạng." },
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000002", "startMs": 30000, "endMs": 60000, "text": "Địa chỉ IP xác định thiết bị nhận gói tin." },
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000003", "startMs": 60000, "endMs": 90000, "text": "Router chọn đường đi dựa trên bảng định tuyến." },
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000004", "startMs": 90000, "endMs": 120000, "text": "TCP chia dữ liệu thành các segment có thứ tự." },
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000005", "startMs": 120000, "endMs": 150000, "text": "Bên nhận gửi ACK để xác nhận đã nhận đủ dữ liệu." },
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000006", "startMs": 150000, "endMs": 180000, "text": "Khi mất gói, TCP truyền lại phần dữ liệu bị thiếu." },
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000007", "startMs": 180000, "endMs": 210000, "text": "UDP không bảo đảm thứ tự nhưng có độ trễ thấp hơn." },
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000008", "startMs": 210000, "endMs": 240000, "text": "DNS dịch tên miền thành địa chỉ IP." },
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000009", "startMs": 240000, "endMs": 270000, "text": "HTTP chạy trên TCP và mô tả cách trao đổi tài nguyên." },
    { "transcriptCueId": "aaaaaaa1-0000-4000-8000-000000000010", "startMs": 270000, "endMs": 300000, "text": "TLS bổ sung lớp mã hóa cho kết nối HTTP." }
  ]
}
