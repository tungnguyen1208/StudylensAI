{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionQuizMessageEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "contractVersion", "correlationId", "tabId", "youtubeVideoId", "occurredAtUtc", "payload"],
  "properties": {
    "type": { "const": "QUIZ_AVAILABLE" },
    "contractVersion": { "const": "0.2.0" },
    "correlationId": { "type": "string", "minLength": 1 },
    "tabId": { "type": "integer", "minimum": 0 },
    "youtubeVideoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
    "occurredAtUtc": { "type": "string", "format": "date-time" },
    "payload": { "$ref": "#/$defs/quizAvailable" }
  },
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["youtubeVideoId", "startMs", "endMs"], "properties": { "youtubeVideoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" }, "startMs": { "type": "integer", "minimum": 0 }, "endMs": { "type": "integer", "minimum": 1 } } },
    "option": { "type": "object", "additionalProperties": false, "required": ["optionId", "text"], "properties": { "optionId": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } } },
    "question": { "type": "object", "additionalProperties": false, "required": ["questionId", "type", "prompt", "source"], "properties": { "questionId": { "type": "string", "format": "uuid" }, "type": { "type": "string", "enum": ["multipleChoice", "shortAnswer"] }, "prompt": { "type": "string", "minLength": 1 }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } }, "source": { "$ref": "#/$defs/source" } } },
    "quizAvailable": { "type": "object", "additionalProperties": false, "required": ["quizId", "sessionId", "segmentId", "questions", "createdAtUtc"], "properties": { "quizId": { "type": "string", "format": "uuid" }, "sessionId": { "type": "string", "format": "uuid" }, "segmentId": { "type": "string", "format": "uuid" }, "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }, "createdAtUtc": { "type": "string", "format": "date-time" } } }
  }
}
