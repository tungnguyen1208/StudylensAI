{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssessmentHistoryMessageEnvelope",
  "description": "Optional Extension-internal status envelope. Answer and history data travel through the Assessment HTTP API; private grading data never crosses this boundary.",
  "type": "object",
  "required": [
    "type",
    "contractVersion",
    "correlationId",
    "occurredAtUtc",
    "payload"
  ],
  "properties": {
    "type": {
      "enum": ["OPERATION_STATUS_CHANGED"],
      "description": "The only Assessment-related extension message is an operation status update."
    },
    "contractVersion": {
      "type": "string",
      "default": "0.4.0"
    },
    "correlationId": {
      "type": "string"
    },
    "tabId": {
      "type": "integer"
    },
    "youtubeVideoId": {
      "type": "string"
    },
    "occurredAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": ["operation", "state", "message", "retryable"],
      "properties": {
        "operation": { "enum": ["answerSubmit", "historyLoad"] },
        "state": { "enum": ["pending", "succeeded", "failed"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "traceId": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
