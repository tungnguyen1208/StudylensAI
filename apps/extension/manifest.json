{
  "manifest_version": 3,
  "name": "StudyLens AI",
  "version": "0.4.0",
  "description": "Active learning companion for YouTube captions and quiz generation.",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*", "http://localhost:5000/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "StudyLens: open learning panel" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["content-script.js"], "run_at": "document_idle" }]
}
